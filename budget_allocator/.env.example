# budget_allocator/.env.example
# --------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.

# --- Database ---
# Provide the full DSN **or** individual components.
# If DATABASE_URL is provided, individual components are ignored.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# --- Application ---
DEBUG=false
DB_ECHO=false

# --- Admin Seeding ---
# Credentials for the initial admin user provisioned on startup
ADMIN_USERNAME=tejasbhat2001@gmail.com
ADMIN_PASSWORD=Rdl@12345

# --- Security ---
# Generate with: openssl rand -hex 32
# The app will refuse to start if this is missing or still set to a placeholder.
SECRET_KEY=CHANGE_ME_TO_A_VALID_HEX_SECRET_AT_LEAST_32_CHARS_LONG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SETUP_TOKEN_EXPIRE_HOURS=72

# --- TOTP / MFA ---
TOTP_ISSUER=BudgetAllocator
